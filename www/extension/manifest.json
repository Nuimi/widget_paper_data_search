{
  "manifest_version": 3,
  "name": "Q-Quartile Finder",
  "version": "1.0.0",
  "action": {
    "default_popup": "index.html",
    "default_icon": {
      "128": "assets/images/icon/ico.png"
    }
  },
  "permissions": ["storage", "contextMenus", "scripting", "activeTab"],
  "host_permissions": ["https://*/*", "http://*/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
      {
      "matches": ["https://*/*", "http://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],

  "icons": {
    "128": "assets/images/icon/ico.png"
  }
}
